# --- Required: Nebius Token Factory (https://tokenfactory.nebius.com) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Optional: pin exact model IDs. Leave blank to auto-resolve Nemotron
#     Nano / Super / Ultra from the /v1/models catalog at startup.
#     Run `python -m autofix models` to see what was resolved.
AUTOFIX_MODEL_NANO=
AUTOFIX_MODEL_SUPER=
AUTOFIX_MODEL_ULTRA=

# --- Optional integrations ---
GITHUB_TOKEN=            # needs contents:write + pull_requests:write to open PRs
GITHUB_WEBHOOK_SECRET=   # set the same secret on the GitHub webhook
TAVILY_API_KEY=          # lets the agent search the web for library/API changes

# --- Agent budget ---
AUTOFIX_MAX_ATTEMPTS=4
AUTOFIX_MAX_STEPS=14
AUTOFIX_ESCALATE_AFTER=2     # Super attempts before escalating to Ultra
AUTOFIX_TEST_TIMEOUT=180

# --- Deployment ---
# AUTOFIX_PUBLIC_MODE=1      # hosted demo: only bundled example repos may be run
# AUTOFIX_SANDBOX=docker     # run test commands inside a throwaway container
# AUTOFIX_DOCKER_IMAGE=python:3.12-slim
