# --- Required: Nebius Token Factory (https://tokenfactory.nebius.com) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Optional: pin exact model IDs. Leave blank to auto-resolve Nemotron
#     Nano / Super / Ultra from the /v1/models catalog at startup.
#     Run `python -m autofix models` to see what was resolved.
AUTOFIX_MODEL_NANO=
AUTOFIX_MODEL_SUPER=
AUTOFIX_MODEL_ULTRA=

# --- Optional integrations ---
# needs contents:write + pull_requests:write to open PRs
GITHUB_TOKEN=
# set the same secret on the GitHub webhook
GITHUB_WEBHOOK_SECRET=
# lets the agent search the web for library/API changes
TAVILY_API_KEY=

# --- Agent budget ---
AUTOFIX_MAX_ATTEMPTS=4
AUTOFIX_MAX_STEPS=14
# Super attempts before escalating to Ultra
AUTOFIX_ESCALATE_AFTER=2
AUTOFIX_TEST_TIMEOUT=180

# --- Deployment ---
# hosted demo: only bundled example repos may be run
# AUTOFIX_PUBLIC_MODE=1
# run test commands inside a throwaway container
# AUTOFIX_SANDBOX=docker
# AUTOFIX_DOCKER_IMAGE=python:3.12-slim
